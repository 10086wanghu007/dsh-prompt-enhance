{
  "name": "dsh-prompt-enhance",
  "version": "1.1.0",
  "description": "Composer button for the DeepSeek Harness Web GUI that rewrites the current draft into a clearer, more executable prompt.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "composer"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}